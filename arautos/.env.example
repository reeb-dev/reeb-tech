DATABASE_URL=jdbc:postgresql://localhost:5432/arautos
DATABASE_USER=arautos
DATABASE_PASSWORD=arautos
ARAUTOS_JWT_SECRET=cambiar-este-secreto-en-produccion-32c
ARAUTOS_TRIAL_DAYS=14
ARAUTOS_PLAN_ID=starter
ARAUTOS_PLAN_NAME=Starter
# Dejar vacíos hasta que Manuel fije montos (no inventar públicos)
ARAUTOS_PLAN_PRICE_USD=
ARAUTOS_PLAN_PRICE_ARS=
ARAUTOS_CORS_ORIGINS=http://localhost:4200
ARAUTOS_SEED=true
SERVER_PORT=8080

# Fase 1b — Mercado Pago (sin secrets reales en el repo)
ARAUTOS_MP_ENABLED=false
ARAUTOS_MP_ACCESS_TOKEN=
ARAUTOS_MP_PUBLIC_KEY=
ARAUTOS_MP_WEBHOOK_SECRET=
ARAUTOS_MP_SUCCESS_URL=http://localhost:4200/panel?mp=success
ARAUTOS_MP_PENDING_URL=http://localhost:4200/panel?mp=pending
ARAUTOS_MP_FAILURE_URL=http://localhost:4200/panel?mp=failure
ARAUTOS_MP_NOTIFICATION_URL=http://localhost:8080/api/public/mp/webhook

# Facebook Login (cuenta AR Autos) ≠ Meta Connect (páginas/IG por tenant)
# App ID no es secreto; App Secret y tokens NUNCA en Git ni en el chat.
ARAUTOS_OAUTH_FACEBOOK_ENABLED=false
ARAUTOS_OAUTH_FACEBOOK_CLIENT_ID=
ARAUTOS_OAUTH_FACEBOOK_CLIENT_SECRET=
ARAUTOS_OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:8080/api/auth/oauth/facebook/callback
ARAUTOS_OAUTH_META_CONNECT_REDIRECT_URI=http://localhost:8080/api/panel/social/meta/callback
ARAUTOS_OAUTH_FRONTEND_LOGIN_URL=http://localhost:4200/panel/oauth/callback
ARAUTOS_PUBLIC_BASE_URL=http://localhost:4200

